{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "pi-mcp-adapter": ["./sidecar/types/pi-mcp-adapter.d.ts"],
      "pi-claude-bridge/src/index.ts": ["./sidecar/types/pi-claude-bridge.d.ts"]
    }
  },
  "include": ["sidecar", "shared"]
}
