{
  "name": "ignite",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "node scripts/vite.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "node scripts/tauri.mjs",
    "demo": "IGNITE_DEMO=1 node scripts/tauri.mjs dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sidecar.json",
    "lint": "pnpm run lint:js && cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check --cache . && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "test": "vitest run && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "setup": "node launcher/setup.mjs",
    "uninstall": "node launcher/uninstall.mjs",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test",
    "prepare": "git config --get core.hooksPath || git config core.hooksPath .githooks",
    "lint:js": "oxlint --deny-warnings && eslint . --cache --cache-location node_modules/.cache/eslint/ && knip"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.311",
    "@anthropic-ai/sandbox-runtime": "^0.0.81",
    "@base-ui/react": "^1.8.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@iconify-json/lucide": "^1.2.142",
    "@iconify-json/simple-icons": "^1.2.99",
    "@react-spring/web": "^10.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-notification": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "@tauri-apps/plugin-store": "^2.4.5",
    "@vitejs/plugin-react": "^6.0.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "daisyui": "^5.7.47",
    "html-to-image": "^1.11.13",
    "ignore": "^7.0.10",
    "jsonc-parser": "^3.3.1",
    "konva": "^10.7.0",
    "lucide-react": "^1.48.0",
    "node-pty": "^1.1.0",
    "partial-json": "0.1.7",
    "pi-claude-bridge": "0.9.3",
    "pi-mcp-adapter": "7.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-konva": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.13.3",
    "recheck": "4.6.0-beta.3",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "sigstore": "5.0.0",
    "simple-icons": "^16.32.0",
    "smol-toml": "^1.9.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typebox": "1.3.27",
    "uqr": "^0.1.3",
    "vite": "^8.3.4",
    "web-tree-sitter": "^0.27.0",
    "ws": "^8.22.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "knip": "^6.38.0",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
