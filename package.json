{
  "name": "ignite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "node scripts/tauri.mjs",
    "demo": "IGNITE_DEMO=1 node scripts/tauri.mjs dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sidecar.json",
    "lint": "oxlint --deny-warnings && eslint . && knip && cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "test": "vitest run && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "setup": "bash launcher/setup.sh",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.77",
    "@base-ui/react": "^1.8.0",
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@react-spring/web": "^10.1.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "@tauri-apps/plugin-store": "^2.4.5",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "ignore": "^7.0.10",
    "jsonc-parser": "^3.3.1",
    "konva": "^10.7.0",
    "lucide-react": "^1.48.0",
    "pi-claude-bridge": "0.9.0",
    "pi-mcp-adapter": "2.38.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-konva": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.13.3",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "shiki": "^4.4.3",
    "simple-icons": "^16.32.0",
    "smol-toml": "^1.9.0",
    "tree-sitter-bash": "^0.25.1",
    "tw-animate-css": "^1.4.0",
    "typebox": "1.3.27",
    "uqr": "^0.1.3",
    "web-tree-sitter": "^0.27.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "knip": "^6.38.0",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.0.16",
    "vitest": "^5.0.2"
  }
}
