{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ignite",
  "version": "0.1.0",
  "identifier": "com.ignite.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ignite",
        "width": 900,
        "height": 600,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 28 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "fs": { "requireLiteralLeadingDot": false }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
