{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "sidecar/main.ts",
    "sidecar/start.ts",
    "sidecar/modsHooks.ts",
    "sidecar/*Extension.ts",
    "sidecar/testMcpServer.ts",
    "launcher/*.mjs"
  ],
  "project": [
    "src/**/*.{ts,tsx,css}",
    "sidecar/**/*.ts",
    "shared/**/*.ts",
    "launcher/*.mjs"
  ],
  "ignore": ["src/components/ui/**", "sidecar/types/**"],
  "ignoreBinaries": ["caffeinate", "osascript", "update-desktop-database"]
}
