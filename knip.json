{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "sidecar/main.ts",
    "sidecar/start.ts",
    "sidecar/modsHooks.ts",
    "sidecar/*Extension.ts",
    "sidecar/testMcpServer.ts"
  ],
  "project": ["src/**/*.{ts,tsx,css}", "sidecar/**/*.ts", "shared/**/*.ts"],
  "ignore": ["src/components/ui/**", "sidecar/types/**"],
  "ignoreDependencies": ["pi-claude-bridge", "tree-sitter-bash"],
  "ignoreBinaries": ["caffeinate", "osascript"]
}
